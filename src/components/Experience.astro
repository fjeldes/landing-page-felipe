---
import type { Locale } from '../i18n';
import { t } from '../i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = t(locale);
const experience = text.experience;
---

<section class="py-stack-xl px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto" id="experience">
  <div class="text-center mb-stack-lg">
    <h2 class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg">{experience.title}</h2>
    <div class="h-1 w-20 bg-primary mx-auto mt-stack-sm"></div>
  </div>
  <div class="relative max-w-4xl mx-auto space-y-stack-md before:absolute before:left-4 md:before:left-1/2 before:top-0 before:bottom-0 before:w-px before:bg-white/10">
    {
      experience.items.map((item, i) => (
        <div class="relative flex flex-col md:flex-row gap-stack-md md:items-center">
          <div class={`absolute left-4 md:left-1/2 -translate-x-1/2 w-3 h-3 ${i % 2 === 0 ? 'bg-primary shadow-[0_0_10px_rgba(208,188,255,1)]' : 'bg-secondary shadow-[0_0_10px_rgba(76,215,246,1)]'} rounded-full`}></div>
          <div class={`ml-10 md:ml-0 md:w-1/2 md:pr-16 text-left md:text-right ${i % 2 === 1 ? 'order-1 md:order-2' : ''}`}>
            <p class="text-primary font-label-md text-label-md mb-2">{item.period}</p>
            <h3 class="font-headline-md text-headline-md">{item.role}</h3>
            <p class="text-secondary font-label-md text-label-md">{item.company}</p>
          </div>
          <div class={`ml-10 md:ml-16 md:w-1/2 ${i % 2 === 1 ? 'order-2 md:order-1 md:text-right md:pr-16' : ''}`}>
            <div class={`glass-card p-stack-md rounded-xl ${i % 2 === 1 ? 'text-left' : ''}`}>
              <p class="font-body-md text-body-md text-on-surface-variant">{item.description}</p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>
