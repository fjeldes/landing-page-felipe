---
import type { Locale } from '../i18n';
import { t } from '../i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const text = t(locale);
const projects = text.projects;
---

<section class="py-stack-xl bg-surface-container-lowest/50" id="projects">
  <div class="px-margin-mobile md:px-margin-desktop max-w-container-max mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-end mb-stack-lg gap-stack-sm">
      <div>
        <h2 class="font-headline-lg-mobile text-headline-lg-mobile md:font-headline-lg md:text-headline-lg">{projects.title}</h2>
        <p class="text-on-surface-variant font-body-md text-body-md">{projects.subtitle}</p>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
      <div class="md:col-span-8 group relative glass-card rounded-3xl overflow-hidden border-white/5 hover:border-primary/50 transition-all duration-500">
        <div class="aspect-video overflow-hidden bg-gradient-to-br from-primary/10 to-secondary/10 flex items-center justify-center">
          <span class="material-symbols-outlined text-[80px] text-primary/30">{projects.items[0].icon}</span>
        </div>
        <div class="absolute inset-0 bg-gradient-to-t from-surface via-surface/40 to-transparent opacity-90 p-stack-md flex flex-col justify-end">
          <div class="flex gap-2 mb-stack-sm">
            {projects.items[0].tags.map(tag => (
              <span class="px-3 py-1 bg-primary/20 text-primary border border-primary/30 rounded-full text-[10px] font-bold">{tag}</span>
            ))}
          </div>
          <h3 class="font-headline-md text-headline-md mb-2">{projects.items[0].title}</h3>
          <p class="text-on-surface-variant font-body-md text-body-md max-w-lg mb-stack-sm">{projects.items[0].description}</p>
          <div class="flex gap-stack-sm">
            <span class="material-symbols-outlined p-2 bg-white/5 rounded-full hover:bg-white/10 transition-colors">link</span>
            <span class="material-symbols-outlined p-2 bg-white/5 rounded-full hover:bg-white/10 transition-colors">code</span>
          </div>
        </div>
      </div>
      <div class="md:col-span-4 flex flex-col gap-gutter">
        {projects.items.slice(1).map(item => (
          <div class="flex-1 group relative glass-card rounded-3xl overflow-hidden border-white/5 hover:border-secondary/50 transition-all duration-500">
            <div class="h-full min-h-[200px] overflow-hidden bg-gradient-to-br from-secondary/10 to-tertiary/10 flex items-center justify-center">
              <span class="material-symbols-outlined text-[60px] text-secondary/30">{item.icon}</span>
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-surface via-surface/40 to-transparent opacity-90 p-stack-md flex flex-col justify-end">
              <span class="px-3 py-1 w-fit bg-tertiary/20 text-tertiary border border-tertiary/30 rounded-full text-[10px] font-bold mb-stack-sm">{item.tags[0]}</span>
              <h3 class="font-headline-md text-headline-md mb-2">{item.title}</h3>
              <p class="text-on-surface-variant font-body-md text-body-md mb-stack-sm">{item.description}</p>
              <span class="material-symbols-outlined p-2 w-fit bg-white/5 rounded-full hover:bg-white/10 transition-colors">arrow_outward</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
